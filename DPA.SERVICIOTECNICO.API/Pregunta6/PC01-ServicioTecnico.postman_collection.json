							"path": [
								"api",
								"OrdenReparacion"
							]
						},
						"description": "Registra una orden para el equipo 3 (Apple iPhone 13) con el tipo 2 (Cambio de batería), sin enviar la fecha de ingreso. Comprueba que responde 201 con la orden creada, su id nuevo, la fecha de hoy y la cabecera Location, y guarda el id en la variable ordenReparacionId para los pedidos siguientes."
					},
					"response": []
				},
				{
					"name": "Obtener orden de reparación por id",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Devuelve la orden recién creada\", function () {",
									"    const orden = pm.response.json();",
									"    pm.expect(orden.id).to.eql(Number(pm.collectionVariables.get(\"ordenReparacionId\")));",
									"    pm.expect(orden.descripcionProblema).to.eql(\"No enciende\");",
									"    pm.expect(orden.costoEstimado).to.eql(120);",
									"    pm.expect(orden.estado).to.eql(\"Pendiente\");",
									"    pm.expect(orden.equipoId).to.eql(3);",
									"    pm.expect(orden.tipoReparacionId).to.eql(2);",
									"});",
									"",
									"pm.test(\"Muestra el equipo y el tipo de reparación por su nombre\", function () {",
									"    const orden = pm.response.json();",
									"    pm.expect(orden.equipo).to.eql(\"Apple iPhone 13 (SN-C3003)\");",
									"    pm.expect(orden.tipoReparacion).to.eql(\"Cambio de batería\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
