		{
			"name": "OrdenReparacion (controlador con repositorio)",
			"item": [
				{
					"name": "Listar órdenes de reparación",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const camposDelContrato = [\"id\", \"fechaIngreso\", \"descripcionProblema\", \"costoEstimado\", \"estado\",",
									"    \"equipoId\", \"equipo\", \"tipoReparacionId\", \"tipoReparacion\"];",
									"const estadosPermitidos = [\"Pendiente\", \"En proceso\", \"Reparado\", \"Entregado\", \"Cancelado\"];",
									"",
									"pm.test(\"Código de estado 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"La respuesta es JSON\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Devuelve un arreglo con las órdenes de reparación\", function () {",
									"    pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty;",
									"});",
									"",
									"pm.test(\"Cada orden trae los campos del contrato\", function () {",
									"    pm.response.json().forEach(function (orden) {",
									"        pm.expect(orden).to.include.all.keys(camposDelContrato);",
									"    });",
									"});",
									"",
									"pm.test(\"El equipo y el tipo de reparación vienen como texto\", function () {",
									"    pm.response.json().forEach(function (orden) {",
									"        pm.expect(orden.equipo).to.be.a(\"string\").that.is.not.empty;",
									"        pm.expect(orden.tipoReparacion).to.be.a(\"string\").that.is.not.empty;",
									"    });",
									"});",
									"",
									"pm.test(\"Cada estado es uno de los permitidos\", function () {",
									"    pm.response.json().forEach(function (orden) {",
									"        pm.expect(estadosPermitidos).to.include(orden.estado);",
									"    });",
									"});",
									"",
									"pm.test(\"La orden inicial 1 muestra su equipo y su tipo de reparación\", function () {",
									"    const orden = pm.response.json().find(function (o) { return o.id === 1; });",
									"    pm.expect(orden, \"no está la orden 1 de los datos iniciales\").to.exist;",
									"    pm.expect(orden.equipo).to.eql(\"Samsung Galaxy A54 (SN-A1001)\");",
									"    pm.expect(orden.tipoReparacion).to.eql(\"Cambio de pantalla\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/OrdenReparacion",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"OrdenReparacion"
							]
						},
						"description": "Pide todas las órdenes. Comprueba que responde 200 con un arreglo JSON, que cada orden trae los campos del contrato, que el equipo y el tipo de reparación vienen como texto, que el estado es uno de los permitidos y que la orden 1 de los datos iniciales muestra «Samsung Galaxy A54 (SN-A1001)» y «Cambio de pantalla»."
					},
					"response": []
				},
				{
					"name": "Crear orden de reparación",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"La orden creada trae su id y los datos enviados\", function () {",
									"    const orden = pm.response.json();",
									"    pm.expect(orden.id).to.be.a(\"number\").that.is.above(0);",
									"    pm.expect(orden.descripcionProblema).to.eql(\"No enciende\");",
									"    pm.expect(orden.costoEstimado).to.eql(120);",
									"    pm.expect(orden.estado).to.eql(\"Pendiente\");",
									"    pm.expect(orden.equipoId).to.eql(3);",
									"    pm.expect(orden.tipoReparacionId).to.eql(2);",
									"});",
									"",
									"pm.test(\"La fecha de ingreso es la de hoy (no se envió en el cuerpo)\", function () {",
									"    const orden = pm.response.json();",
									"    const ahora = new Date();",
									"    const dosCifras = function (n) { return String(n).padStart(2, \"0\"); };",
									"    const hoyLocal = ahora.getFullYear() + \"-\" + dosCifras(ahora.getMonth() + 1) + \"-\" + dosCifras(ahora.getDate());",
									"    const hoyUtc = ahora.toISOString().substring(0, 10);",
									"    pm.expect([hoyLocal, hoyUtc]).to.include(String(orden.fechaIngreso).substring(0, 10));",
									"});",
									"",
									"pm.test(\"La cabecera Location apunta a la nueva orden\", function () {",
									"    pm.response.to.have.header(\"Location\");",
									"    const orden = pm.response.json();",
									"    const location = pm.response.headers.get(\"Location\").toLowerCase();",
									"    pm.expect(location).to.match(new RegExp(\"/api/ordenreparacion/\" + orden.id + \"$\"));",
									"});",
									"",
									"// Guarda el id de la orden creada para los pedidos siguientes de esta carpeta.",
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set(\"ordenReparacionId\", pm.response.json().id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"descripcionProblema\": \"No enciende\",\n    \"costoEstimado\": 120.00,\n    \"estado\": \"Pendiente\",\n    \"equipoId\": 3,\n    \"tipoReparacionId\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/OrdenReparacion",
