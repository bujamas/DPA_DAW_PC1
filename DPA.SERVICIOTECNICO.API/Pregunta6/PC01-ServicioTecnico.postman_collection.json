						"description": "Consulta la orden recién creada por su id. Comprueba que responde 200 con los mismos datos y que el equipo y el tipo de reparación vienen por su nombre."
					},
					"response": []
				},
				{
					"name": "Actualizar orden de reparación",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Devuelve la orden con los cambios\", function () {",
									"    const orden = pm.response.json();",
									"    pm.expect(orden.id).to.eql(Number(pm.collectionVariables.get(\"ordenReparacionId\")));",
									"    pm.expect(orden.descripcionProblema).to.eql(\"No enciende, falla el conector de carga\");",
									"    pm.expect(orden.costoEstimado).to.eql(140);",
									"    pm.expect(orden.estado).to.eql(\"En proceso\");",
									"    pm.expect(orden.equipoId).to.eql(3);",
